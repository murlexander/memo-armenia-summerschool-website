---
import latin from '@fontsource-variable/noto-sans/files/noto-sans-latin-wght-normal.woff2?url';
import latinExt from '@fontsource-variable/noto-sans/files/noto-sans-latin-ext-wght-normal.woff2?url';
import cyrillic from '@fontsource-variable/noto-sans/files/noto-sans-cyrillic-wght-normal.woff2?url';
import armenian from '@fontsource-variable/noto-sans-armenian/files/noto-sans-armenian-armenian-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocalSite, href, pageLocation, preview } from '../lib/content.ts';
import { langLabels, langs, uiFor } from '../lib/ui.ts';
import '../styles/global.css';

type Section = 'lost' | 'found' | 'place';

interface Props {
  title?: string;
  description?: string;
  section?: Section;
  /** True on the section's own index page (aria-current="page"), false inside it. */
  sectionIndex?: boolean;
  /** Home only: default variant; ?home=1|2|3 overrides it before first paint. */
  homeVariant?: string;
}

const { title, description, section, sectionIndex = true, homeVariant } = Astro.props;
const { lang, path } = pageLocation(Astro.url);
const ui = uiFor(lang);
const site = await getLocalSite(lang);
const pageTitle = title ? `${title} — ${site.title}` : site.title;
const metaDescription = description ?? site.phrase ?? site.homeVariants['1'].lead ?? site.title;

// One family ("Site Sans") assembled from Noto Sans and Noto Sans Armenian subsets.
const fontFaces = [
  [latin, 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'],
  [latinExt, 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF'],
  [cyrillic, 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116'],
  [armenian, 'U+0530-058F,U+2010,U+2024,U+25CC,U+FB13-FB17'],
].map(([url, range]) => `@font-face{font-family:"Site Sans";font-style:normal;font-display:swap;font-weight:100 900;src:url("${url}") format("woff2");unicode-range:${range}}`).join('');

const homeScript = homeVariant
  ? `(function(){var v=new URLSearchParams(location.search).get('home');if(v==='1'||v==='2'||v==='3')document.documentElement.dataset.home=v;})();`
  : '';
---
<!doctype html>
<html lang={ui.lang} data-home={homeVariant} data-preview={preview ? 'true' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {preview && <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />}
    <link rel="icon" type="image/png" href={href('favicon.png')} />
    {langs.map((code) => <link rel="alternate" hreflang={code} href={href(path, code)} />)}
    <link rel="preload" href={cyrillic} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <script is:inline set:html={`document.documentElement.classList.add('js');${homeScript}`}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <div class="background-grain" aria-hidden="true"></div>
    <Header site={site} lang={lang} section={section} sectionIndex={sectionIndex} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer site={site} lang={lang} />
    <nav class="lang-switch" aria-label={ui.language}>
      {langs.map((code) => (
        <a href={href(path, code)} hreflang={code} lang={code} aria-current={code === lang ? 'true' : undefined}>{langLabels[code]}</a>
      ))}
    </nav>
  </body>
</html>
