---
// Photo with caption and credit. Used on project pages and in MDX (the longread).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { ui } from '../lib/ui.ts';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  /** Eager-load images that are likely above the fold. */
  eager?: boolean;
}

const { src, alt, caption, credit, eager = false } = Astro.props;
const widths = [480, 960, 1440, 2000].filter((width) => width < src.width).concat(src.width > 2000 ? [] : [src.width]);
---
<figure class="media-figure">
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes="(min-width: 960px) 900px, calc(100vw - 2rem)"
    loading={eager ? 'eager' : 'lazy'}
    format="webp"
  />
  {(caption || credit) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      {credit && <span class="credit">{ui.photoCredit}: {credit}</span>}
    </figcaption>
  )}
</figure>
