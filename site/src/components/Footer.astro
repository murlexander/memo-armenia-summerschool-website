---
import Pending from './Pending.astro';
import type { LocalSite } from '../lib/content.ts';
import { uiFor, type Lang } from '../lib/ui.ts';

interface Props {
  site: LocalSite;
  lang: Lang;
}

const { footer } = Astro.props.site;
const ui = uiFor(Astro.props.lang);
---
<footer class="site-footer">
  <p class="footer-text">{footer.text ?? <Pending text={ui.pendingText} />}</p>
  {footer.instagram && (
    <p class="footer-social">
      <a href={`https://www.instagram.com/${footer.instagram}/`} rel="noopener">{ui.instagram} @{footer.instagram}</a>
    </p>
  )}
  {footer.partners.length > 0 && (
    <ul class="footer-partners" aria-label={ui.partners}>
      {footer.partners.map((partner) => <li>{partner.url ? <a href={partner.url} rel="noopener">{partner.name}</a> : partner.name}</li>)}
    </ul>
  )}
</footer>
