---
import Catalogue from '../../../views/Catalogue.astro';
import { translatedLangs } from '../../../lib/ui.ts';

export const getStaticPaths = () => translatedLangs.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params as { lang: (typeof translatedLangs)[number] };
---
<Catalogue lang={lang} />
