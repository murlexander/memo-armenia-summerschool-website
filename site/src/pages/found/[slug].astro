---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Prose from '../../components/Prose.astro';
import YouTube from '../../components/YouTube.astro';
import { getObjects, getProjects, href, objectAnchor, objectsOfProject, preview, type ObjectEntry, type Project } from '../../lib/content.ts';
import { issueLabels, objectIssues, projectIssues } from '../../lib/issues.ts';
import { ui } from '../../lib/ui.ts';

export async function getStaticPaths() {
  const projects = await getProjects();
  const objects = await getObjects();
  return projects
    .map((project) => ({ params: { slug: project.data.slug }, props: { project, ...objectsOfProject(objects, project.data.id) } }))
    // Outside the preview, a project without objects has no page (check-content fails published ones).
    .filter(({ props }) => props.owned.length > 0 || preview);
}

interface Props {
  project: Project;
  owned: ObjectEntry[];
  /** Preview only: objects another project owns but this one lists too. */
  claimed: ObjectEntry[];
}

const { project, owned, claimed } = Astro.props;
const { data } = project;
const issues = preview ? projectIssues(data, { owned: owned.length, claimed: claimed.length }) : [];
// Each object with the note that marks a conflict: who else lists it, or who owns it.
const objects = [
  ...owned.map(({ object, claimedBy }) => ({ object, note: claimedBy.length > 0 ? `${ui.alsoClaimedBy} «${claimedBy.map((other) => other.data.title).join('», «')}»` : '' })),
  ...claimed.map(({ object, project: owner }) => ({ object, note: `${ui.ownedBy} «${owner?.data.title}»` })),
].map((entry) => ({ ...entry, marked: preview && (entry.note !== '' || objectIssues(entry.object.data).length > 0) }));
const placeholder = (value: string) => (preview && !value.trim() ? ui.notSpecified : value);
---
<Base title={data.title} section="found" sectionIndex={false} description={`${data.title}. ${ui.team}: ${data.team.join(', ')}`}>
  <article class="page-shell project">
    <p class="back-row"><a class="back-link" href={href('found/')}>← {ui.allProjects}</a></p>
    <div class="project-layout">
      <div class="project-main">
        <header class="project-head">
          {data.studio && <p class="eyebrow">{ui.studio}: {data.studio}</p>}
          <h1>{data.title}</h1>
          <dl class="project-facts">
            <div>
              <dt>{ui.team}</dt>
              <dd>{placeholder(data.team.join(', '))}</dd>
            </div>
            <div>
              <dt>{ui.materials}</dt>
              <dd>{data.materials.trim() ? <Prose source={data.materials} /> : placeholder('')}</dd>
            </div>
          </dl>
        </header>
        {issues.length > 0 && (
          <aside class="issue-panel" aria-labelledby="open-issues">
            <h2 id="open-issues">{ui.openIssues}</h2>
            <ul class="issue-list">{issues.map((code) => <li>{issueLabels[code]}</li>)}</ul>
          </aside>
        )}

        <section class="project-objects" aria-labelledby="project-objects">
          <h2 id="project-objects" class="visually-hidden">{ui.projectObjects}</h2>
          <ul>
            {objects.map(({ object, note, marked }) => (
              <li data-issues={marked ? 'true' : undefined}>
                <a href={`${href('')}#${objectAnchor(object.data.id)}`}>
                  {marked && <span class="issue-badge" aria-hidden="true">!</span>}
                  <Image src={object.data.image} alt={object.data.alt} widths={[320, 640]} sizes="320px" format="webp" />
                  <span>{object.data.label} <span class="visually-hidden">— {ui.findOnField}</span><span aria-hidden="true">↗</span></span>
                </a>
                {note && <p class="object-note">{note}</p>}
              </li>
            ))}
            {objects.length === 0 && preview && <li class="project-object-placeholder placeholder-box">{ui.noObject}</li>}
          </ul>
        </section>

        {(data.history.trim() || preview) && (
          <section class="project-text" aria-labelledby="history">
            <h2 id="history">{ui.history}</h2>
            {data.history.trim() ? <Prose source={data.history} /> : <p class="placeholder-text">{ui.noText}</p>}
          </section>
        )}
        {(data.fromAuthor.trim() || preview) && (
          <section class="project-text" aria-labelledby="from-author">
            <h2 id="from-author">{ui.fromAuthor}</h2>
            {data.fromAuthor.trim() ? <Prose source={data.fromAuthor} /> : <p class="placeholder-text">{ui.noText}</p>}
          </section>
        )}
      </div>
      {data.media.length === 0 && preview && (
        <section class="project-media" aria-label={ui.media}>
          <p class="placeholder-box project-media-placeholder">{ui.noPhotos}</p>
        </section>
      )}
      {data.media.length > 0 && (
        <section class="project-media" aria-labelledby="media">
          <h2 id="media">{ui.media}</h2>
          {data.media.map((item) => item.type === 'image'
            ? <Figure src={item.src} alt={item.alt} caption={item.caption} credit={item.credit} />
            : <YouTube id={item.id} title={item.title} poster={item.poster} />)}
        </section>
      )}
    </div>
  </article>
</Base>
