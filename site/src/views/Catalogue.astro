---
import Base from '../layouts/Base.astro';
import CatalogueFilters from '../components/CatalogueFilters.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { getLocalSite, getObjects, getProjects, objectsOfProject, preview, projectObjectStatus } from '../lib/content.ts';
import { uiFor, type Lang } from '../lib/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = uiFor(lang);
const site = await getLocalSite(lang);
const projects = await getProjects();
const objects = await getObjects();
const tiles = projects
  .map((project) => {
    const { owned, claimed } = objectsOfProject(objects, project.data.id);
    const status = projectObjectStatus(project, owned, claimed);
    // One project, one object: the cut-out only when it is settled; otherwise a grey or red circle.
    return { project, status, cutout: status === 'certain' ? owned[0]?.object : undefined };
  })
  // Outside the preview, projects without objects are never listed (check-content fails published ones).
  .filter((tile) => tile.cutout || preview);
---
<Base title={site.menu.found} section="found">
  <div class="page-shell">
    <header class="page-head">
      {/* The underlined header word already names the section; the heading stays for screen readers. */}
      <h1 class="visually-hidden">{site.menu.found}</h1>
      <p class="page-sub">{ui.catalogue}</p>
    </header>
    {tiles.length === 0 ? <p>{ui.catalogueEmpty}</p> : (
      <>
      <CatalogueFilters projects={tiles.map(({ project }) => project)} lang={lang} />
      <ul class="catalogue">
        {tiles.map(({ project, status, cutout }) => (
          <li data-project-id={project.data.id} data-studio={project.data.studio} data-medium={project.data.medium.join(' ')} data-shift={project.data.shift}>
            <ProjectTile lang={lang} project={project} status={status} cutout={cutout} />
          </li>
        ))}
      </ul>
      </>
    )}
  </div>
</Base>
