---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Pending from '../components/Pending.astro';
import { getLocalSite, getObjects, getProjects, localizeProject, objectsOfProject, preview, projectHref, projectObjectStatus } from '../lib/content.ts';
import { uiFor, type Lang } from '../lib/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = uiFor(lang);
const site = await getLocalSite(lang);
const projects = await getProjects();
const objects = await getObjects();
const tiles = (await Promise.all(projects.map(async (project) => {
  const { owned, claimed } = objectsOfProject(objects, project.data.id);
  const status = projectObjectStatus(project, owned, claimed);
  return {
    project,
    text: await localizeProject(project, lang),
    status,
    // One project, one object: the cut-out only when it is settled; otherwise a grey or red circle.
    cutout: status === 'certain' ? owned[0]?.object : undefined,
  };
})))
  // Outside the preview, projects without objects are never listed (check-content fails published ones).
  .filter((tile) => tile.cutout || preview);
---
<Base title={site.menu.found} section="found">
  <div class="page-shell">
    <header class="page-head">
      {/* The underlined header word already names the section; the heading stays for screen readers. */}
      <h1 class="visually-hidden">{site.menu.found}</h1>
      <p class="page-sub">{ui.catalogue}</p>
    </header>
    {tiles.length === 0 ? <p>{ui.catalogueEmpty}</p> : (
      <ul class="catalogue">
        {tiles.map(({ project, text, status, cutout }) => (
          <li>
            <a class="catalogue-tile" href={projectHref(project.data.slug, lang)}>
              {cutout ? (
                <span class="catalogue-image">
                  <Image src={cutout.data.image} alt="" widths={[240, 480]} sizes="(min-width: 720px) 240px, 45vw" format="webp" loading="lazy" />
                </span>
              ) : (
                <span class="catalogue-image" title={status === 'unknown' ? ui.noObject : ui.objectUncertain}>
                  <span class="project-circle" data-kind={status} aria-hidden="true"></span>
                  <span class="visually-hidden">{status === 'unknown' ? ui.noObject : ui.objectUncertain}</span>
                </span>
              )}
              <span class="catalogue-title">{text.title ?? <Pending text={ui.pendingTitle} />}</span>
              {text.team.length > 0 && (
                <span class="catalogue-team">{text.team.some((name) => name === null) ? <Pending text={ui.pendingName} /> : text.team.join(', ')}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
