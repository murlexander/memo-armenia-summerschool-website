---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import YouTube from '../components/YouTube.astro';
import PlaceMap from '../components/PlaceMap.astro';
import { getLocalSite, getLongreadFor } from '../lib/content.ts';
import { uiFor, type Lang } from '../lib/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = uiFor(lang);
const site = await getLocalSite(lang);
const page = await getLongreadFor(lang);
const rendered = page ? await render(page) : undefined;
const Content = rendered?.Content;
---
<Base title={page?.data.title ?? site.menu.place} description={page?.data.description} section="place">
  <article class="page-shell longread">
    <header class="page-head">
      {/* The underlined header word already names the section; the heading stays for screen readers. */}
      <h1 class="visually-hidden">{page?.data.title ?? site.menu.place}</h1>
      {page?.data.description && <p class="page-sub">{page.data.description}</p>}
    </header>
    <div class="prose longread-body">
      {Content ? <Content components={{ Figure, YouTube }} /> : <p>{ui.longreadPending}</p>}
    </div>
    <PlaceMap lang={lang} />
  </article>
</Base>
